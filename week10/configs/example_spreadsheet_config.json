{
    "input_file": "data/input_data.xlsx",
    "output_file": "data/output_report.xlsx",
    "tasks": [
        {
            "type": "copy_data",
            "source_sheet": "SalesData",
            "dest_sheet": "Raw Data"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "D",
            "header": "Total Revenue",
            "start_row": 2,
            "formula": "=B{row}*C{row}",
            "number_format": "#,##0.00"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "D2:D100",
            "rule_type": "color_scale",
            "min_color": "FF0000",
            "mid_color": "FFFF00",
            "max_color": "00FF00"
        },
        {
            "type": "chart",
            "sheet": "Raw Data",
            "chart_type": "bar",
            "data_range": "D1:D5",
            "category_range": "A2:A5",
            "title": "Top 4 Product Revenue",
            "x_axis_title": "Product",
            "y_axis_title": "Revenue",
            "top_left_cell": "G2"
        },
        {
            "type": "calculate_column",
            "sheet": "Raw Data",
            "target_column": "E",
            "header": "Status",
            "start_row": 2,
            "formula": "=IF(D{row}>1000,\"High Value\",\"Standard\")"
        },
        {
            "type": "conditional_format",
            "sheet": "Raw Data",
            "range": "E2:E100",
            "rule_type": "expression",
            "formula": "=$E2=\"High Value\"",
            "fill_color": "92D050",
            "font_color": "000000"
        }
    ]
}
